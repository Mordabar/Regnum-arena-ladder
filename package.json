{
    "name": "regnum-arena-ladder",
    "description": "Regnum Arena Ladder - Conquest PvP System",
    "version": "1.0.0",
    "scripts": {
        "dev": "vite",
        "build": "npm run build:site && npm run build:admin",
        "build:site": "tailwindcss -i resources/css/site.css -o public/css/site.css --minify",
        "build:admin": "tailwindcss -c tailwind.admin.config.js -i resources/css/admin.css -o public/css/admin.css --minify",
        "check:css": "node tools/check-css-coverage.mjs"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "autoprefixer": "^10.4.17",
        "laravel-vite-plugin": "^1.0.2",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "vite": "^5.1.4"
    }
}
