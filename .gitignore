/vendor/
/node_modules/
/.env
/.env.*
!/.env.example
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
/storage/*.key
/public/storage

# Se ignora el CONTENIDO de estas carpetas, no la carpeta en si: cada una
# conserva un .gitkeep para que exista en cualquier despliegue. Sin eso git no
# versiona carpetas vacias, no llegan al servidor y Laravel aborta al arrancar
# con "The bootstrap/cache directory must be present and writable".
# Ojo: hay que ignorar con /carpeta/* (no /carpeta), porque si se ignora la
# carpeta entera git ni siquiera mira dentro y el !.gitkeep no surte efecto.
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/framework/testing/*
/storage/logs/*
!/storage/logs/.gitkeep

# Artefactos generados al correr la suite de tests
/.phpunit.cache
/.phpunit.result.cache
/storage/app/arena-reports/match-reports/testing/
